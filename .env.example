# Exposed to the browser by Vite. Use the same values in Vercel Preview and Production.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only values. Never prefix these with VITE_ or expose them in client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_BOOTSTRAP_PASSWORD=change-this-before-deploying

# Optional email settings used by OTP flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=# Public (safe in the browser / Vercel "Vite" env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel environment variables, NOT VITE_ prefixed)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_BOOTSTRAP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM=
APP_URL=
OTP_PEPPER=
PORT=
